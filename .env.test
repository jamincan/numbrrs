# Loaded by Vite for mode=test (Vitest's default), layered over .env — never
# loaded by `pnpm dev` or `pnpm build`.
#
# Blank on purpose: notify() in $lib/server/alerts.ts no-ops when this is
# unset, so no test run can ever reach a real webhook regardless of what a
# developer's own .env has configured for local dev. This is the foundational
# layer; leagues/index.test.ts additionally mocks ../alerts outright, and
# src/test-setup.ts stubs fetch globally as a last resort for anything else.
ALERT_WEBHOOK_URL=
