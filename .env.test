# Loaded by Vite for mode=test (Vitest's default), layered over .env — never
# loaded by `pnpm dev` or `pnpm build`.
#
# Blank so a test run doesn't inherit the webhook from a developer's own .env:
# with no URL, reportError() in #lib/server/alerts.ts records the error and
# posts nothing. This is a backstop, not the guard — a variable exported in the
# shell beats this file. The guard is src/test-setup.ts, which replaces
# $app/env/private for every test file and stubs fetch globally.
ALERT_WEBHOOK_URL=
