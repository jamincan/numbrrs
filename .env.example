# Path to the SQLite database file.
# Defaults to local.db in the project root if not set.
DATABASE_URL=local.db

# Password for the /admin dashboard, which is also what authorises a manual
# roster resync. Generate with: openssl rand -hex 32
# /admin reports itself unconfigured until this is set, and rotating it signs
# every existing session out.
ADMIN_TOKEN=

# Discord webhook that server, client and sync errors are pushed to.
# Errors are still recorded to the database while this is unset.
ALERT_WEBHOOK_URL=
