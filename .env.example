# Path to the SQLite database file.
# Defaults to local.db in the project root if not set.
DATABASE_URL=local.db

# Password for the /admin dashboard, which is also what authorises a manual
# roster resync. Generate with: openssl rand -hex 32
# /admin reports itself unconfigured until this is set, and rotating it signs
# every existing session out.
ADMIN_TOKEN=

# Emergency switch for when Cloudflare is down. In production numbrrs.fly.dev
# redirects to numbrrs.app (all but /api/health), and /admin only answers
# requests that came through Cloudflare Access. Set this to 1 (or true) and
# numbrrs.fly.dev serves the whole site itself, with /admin relying on
# ADMIN_TOKEN alone; an alert goes out at every boot until it is unset again.
# Has no effect in local dev, which is neither hostname and never has Access in
# front of it.
ADMIN_DIRECT=

# Secret the Cloudflare Workers present when they report to the origin (page
# views served from the edge cache). The same value is stored on each Worker
# with `wrangler secret put EDGE_TOKEN`. Generate with: openssl rand -hex 32
# Those reports are refused while this is unset.
EDGE_TOKEN=

# Discord webhook that server, client and sync errors are pushed to.
# Errors are still recorded to the database while this is unset.
ALERT_WEBHOOK_URL=
